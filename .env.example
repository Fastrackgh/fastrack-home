# Frontend settings. Copy to .env.local for development; set them in the host's
# build environment for production (docs/deployment.md). NEXT_PUBLIC_ values are
# baked into the build, so changing one means building again.

# Required in production: the backend API address, ending in /api.
# A production build fails without it. Development defaults to
# http://localhost:3000/api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: the public site's address, used in link previews (Open Graph).
# Left out of the page when unset.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional, development only: serve the parent portal from mock data.
# NEXT_PUBLIC_PARENT_API_MOCK=1

# Optional, demo deployments only: show the staff pages that are still UI
# previews with sample data (Communication, Timetable, Budgets and others).
# Leave unset for real schools, so they never see invented figures (QA-290).
# NEXT_PUBLIC_SHOW_PREVIEW_PAGES=1

# Optional, server only (never NEXT_PUBLIC_): the access code for the Business
# Guide at /guide. Read when a request comes in, so changing it needs a restart,
# not a rebuild, and signs everyone out. Unset: the guide stays locked.
# BUSINESS_GUIDE_CODE=
